  "vo": [
    { "id": "vo0", "scene": "s0", "start": 5.4, "end": 9.3, "text": "Une barre protéinée, en général, ça se fabrique comme une cloison." },

    { "id": "vo1a", "scene": "s1", "start": 10.4, "end": 11.8, "text": "On mélange de la poudre." },
    { "id": "vo1b", "scene": "s1", "start": 12.3, "end": 13.1, "text": "On presse." },
    { "id": "vo1c", "scene": "s1", "start": 13.7, "end": 14.9, "text": "On laisse sécher." },
    { "id": "vo1d", "scene": "s1", "start": 15.6, "end": 17.3, "text": "Et toi, tu manges un mur." },

    { "id": "vo2a", "scene": "s2", "start": 18.3, "end": 20.1, "text": "Chez MORDU, on a repris à zéro." },
    { "id": "vo2b", "scene": "s2", "start": 20.5, "end": 23.4, "text": "Une usine propre, lumineuse, avec des écrans tactiles." },
    { "id": "vo2c", "scene": "s2", "start": 23.7, "end": 24.7, "text": "On est modernes." },

    { "id": "vo3a", "scene": "s3", "start": 25.4, "end": 27, "text": "Étape un : les cacahuètes." },
    { "id": "vo3b", "scene": "s3", "start": 27.4, "end": 28.1, "text": "Entières." },
    { "id": "vo3c", "scene": "s3", "start": 28.6, "end": 32.4, "text": "Triées une par une par quelqu'un qui n'a que ça à faire." },

    { "id": "vo4a", "scene": "s4", "start": 34.4, "end": 35.9, "text": "Étape deux : le caramel." },
    { "id": "vo4b", "scene": "s4", "start": 36.3, "end": 39.7, "text": "Quinze centimètres d'étirement minimum, sinon on recommence." },
    { "id": "vo4c", "scene": "s4", "start": 40.2, "end": 42.4, "text": "Un caramel qui ne s'étire pas ment." },

    { "id": "vo5a", "scene": "s5", "start": 43.4, "end": 44.9, "text": "Étape trois : le chocolat." },
    { "id": "vo5b", "scene": "s5", "start": 45.3, "end": 46.8, "text": "Mat. Pas de vernis." },
    { "id": "vo5c", "scene": "s5", "start": 47.3, "end": 49.3, "text": "Si ça brille, c'est du plastique." },

    { "id": "vo6a", "scene": "s6", "start": 50.4, "end": 52.2, "text": "Dernière étape : le test du clou." },
    { "id": "vo6b", "scene": "s6", "start": 52.6, "end": 55.6, "text": "Si le clou ne rentre pas, la barre part caler une porte." },
    { "id": "vo6c", "scene": "s6", "start": 56, "end": 57.1, "text": "Quatorze testées." },
    { "id": "vo6d", "scene": "s6", "start": 57.5, "end": 58.9, "text": "Treize portes calées." },

    { "id": "vo7a", "scene": "s7", "start": 62.4, "end": 63, "text": "MORDU." },
    { "id": "vo7b", "scene": "s7", "start": 63.4, "end": 64.4, "text": "Enfin une barre." },
    { "id": "vo7c", "scene": "s7", "start": 64.7, "end": 65.7, "text": "Pas une brique." }
