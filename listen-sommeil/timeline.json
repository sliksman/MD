 "vo": [
  {
   "id": "L01",
   "start": 0.1,
   "end": 2.0,
   "text": "Demain, tu te lèves à sept heures.",
   "hl": [
    "sept",
    "heures."
   ]
  },
  {
   "id": "L02",
   "start": 2.36,
   "end": 4.36,
   "text": "T'es fatigué,",
   "words": [
    [
     "T'es",
     2.36
    ],
    [
     "fatigué,",
     2.98
    ]
   ],
   "hl": [
    "fatigué,"
   ]
  },
  {
   "id": "L03",
   "start": 4.53,
   "end": 6.44,
   "text": "ça fait une heure que la lumière est éteinte,",
   "hl": [
    "une",
    "heure"
   ]
  },
  {
   "id": "L04",
   "start": 6.64,
   "end": 7.84,
   "text": "mais impossible de dormir !",
   "hl": [
    "impossible"
   ]
  },
  {
   "id": "L05",
   "start": 8.3,
   "end": 10.85,
   "text": "Alors avant de retourner ton oreiller une sixième fois,",
   "hl": [
    "sixième",
    "fois,"
   ]
  },
  {
   "id": "L06",
   "start": 11.1,
   "end": 12.08,
   "text": "essaie ces trois choses.",
   "hl": [
    "trois",
    "choses."
   ]
  },
  {
   "id": "L07",
   "start": 12.55,
   "end": 12.75,
   "text": "Un.",
   "hl": [
    "Un."
   ]
  },
  {
   "id": "L08",
   "start": 13.16,
   "end": 13.58,
   "text": "T'as chaud,",
   "hl": [
    "chaud,"
   ]
  },
  {
   "id": "L09",
   "start": 13.86,
   "end": 15.23,
   "text": "alors mets des chaussettes.",
   "hl": [
    "chaussettes."
   ]
  },
  {
   "id": "L10",
   "start": 15.65,
   "end": 19.87,
   "text": "Aussi bizarre que ça puisse paraître, réchauffer tes pieds peut aider ton corps à refroidir.",
   "hl": [
    "bizarre",
    "réchauffer",
    "refroidir."
   ]
  },
  {
   "id": "L11",
   "start": 20.36,
   "end": 24.34,
   "text": "La chaleur dilate les petits vaisseaux et facilite l'évacuation de la chaleur du corps.",
   "hl": [
    "dilate",
    "l'évacuation"
   ]
  },
  {
   "id": "L12",
   "start": 24.84,
   "end": 27.57,
   "text": "Cette baisse de température va aider ton corps à s'endormir.",
   "hl": [
    "baisse",
    "s'endormir."
   ]
  },
  {
   "id": "L13",
   "start": 28.11,
   "end": 28.59,
   "text": "Voilà,",
   "hl": []
  },
  {
   "id": "L14",
   "start": 28.73,
   "end": 29.85,
   "text": "maintenant t'es confortable.",
   "hl": [
    "confortable."
   ]
  },
  {
   "id": "L15",
   "start": 30.17,
   "end": 31.82,
   "text": "Mais ta tête, elle, n'est pas prête à s'endormir !",
   "hl": [
    "tête,",
    "pas",
    "prête"
   ]
  },
  {
   "id": "L16",
   "start": 31.96,
   "end": 34.54,
   "text": "Elle a décidé de préparer toute ta semaine.",
   "hl": [
    "toute",
    "ta",
    "semaine."
   ]
  },
  {
   "id": "L17",
   "start": 34.93,
   "end": 35.42,
   "text": "Deux.",
   "hl": [
    "Deux."
   ]
  },
  {
   "id": "L18",
   "start": 35.79,
   "end": 37.35,
   "text": "Occupe ton esprit.",
   "words": [
    [
     "Occupe",
     35.79
    ],
    [
     "ton",
     36.52
    ],
    [
     "esprit.",
     36.78
    ]
   ],
   "hl": [
    "esprit."
   ]
  },
  {
   "id": "L19",
   "start": 37.78,
   "end": 38.8,
   "text": "Imagine une pomme.",
   "hl": [
    "pomme."
   ]
  },
  {
   "id": "L20",
   "start": 39.28,
   "end": 39.83,
   "text": "Quelques secondes.",
   "hl": [
    "secondes."
   ]
  },
  {
   "id": "L21",
   "start": 40.36,
   "end": 41.39,
   "text": "Puis un parapluie.",
   "hl": [
    "parapluie."
   ]
  },
  {
   "id": "L22",
   "start": 41.78,
   "end": 42.72,
   "text": "Puis une chaise.",
   "hl": [
    "chaise."
   ]
  },
  {
   "id": "L23",
   "start": 43.13,
   "end": 43.97,
   "text": "Des objets simples,",
   "hl": [
    "simples,"
   ]
  },
  {
   "id": "L24",
   "start": 44.09,
   "end": 44.88,
   "text": "sans lien entre eux.",
   "hl": [
    "sans",
    "lien"
   ]
  },
  {
   "id": "L25",
   "start": 45.32,
   "end": 46.55,
   "text": "Pas d'histoire à construire,",
   "hl": [
    "d'histoire"
   ]
  },
  {
   "id": "L26",
   "start": 46.68,
   "end": 47.69,
   "text": "pas de liste à réussir.",
   "hl": [
    "liste"
   ]
  },
  {
   "id": "L27",
   "start": 48.16,
   "end": 49.9,
   "text": "Ça s'appelle le cognitive shuffle :",
   "hl": [
    "cognitive",
    "shuffle"
   ]
  },
  {
   "id": "L28",
   "start": 50.27,
   "end": 53.93,
   "text": "une technique à tester pour détourner ton attention des pensées qui tournent en boucle.",
   "hl": [
    "tester",
    "tournent",
    "en",
    "boucle."
   ]
  },
  {
   "id": "L29",
   "start": 54.3,
   "end": 56.79,
   "text": "Là, normalement, tu es sur le point de t'endormir,",
   "hl": [
    "t'endormir,"
   ]
  },
  {
   "id": "L30",
   "start": 57.09,
   "end": 61.22,
   "text": "mais au moment de fermer les yeux, ton voisin décide visiblement de refaire toute sa cuisine.",
   "hl": [
    "voisin",
    "toute",
    "sa",
    "cuisine."
   ]
  },
  {
   "id": "L31",
   "start": 61.65,
   "end": 61.99,
   "text": "Trois.",
   "hl": [
    "Trois."
   ]
  },
  {
   "id": "L32",
   "start": 62.49,
   "end": 64.6,
   "text": "Essaie un fond sonore doux.",
   "words": [
    [
     "Essaie",
     62.49
    ],
    [
     "un",
     63.26
    ],
    [
     "fond",
