    ]
   ],
   "hl": [
    "sonore",
    "doux."
   ]
  },
  {
   "id": "L33",
   "start": 65.06,
   "end": 68.4,
   "text": "Rends-toi sur l'app Listen et lance une pluie régulière, par exemple.",
   "hl": [
    "Listen",
    "pluie",
    "régulière,"
   ]
  },
  {
   "id": "L34",
   "start": 68.72,
   "end": 69.97,
   "text": "Si cette ambiance t'apaise,",
   "hl": [
    "t'apaise,"
   ]
  },
  {
   "id": "L35",
   "start": 70.13,
   "end": 71.4,
   "text": "laisse-la accompagner le moment.",
   "hl": [
    "accompagner"
   ]
  },
  {
   "id": "L36",
   "start": 71.81,
   "end": 72.15,
   "text": "Et toi ?",
   "hl": [
    "toi"
   ]
  },
  {
   "id": "L37",
